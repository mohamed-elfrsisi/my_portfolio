/* corner cobweb — old-web nostalgia, paired with the dbana fly cursor */

.corner-web {
  position: fixed;
  top: 0;
  left: 0;
  width: 180px;
  height: 180px;
  pointer-events: none;
  z-index: 40;
  opacity: 0.9;
}

.corner-web svg {
  display: block;
  filter: drop-shadow(0 0 4px rgba(0, 0, 0, 0.35));
}

.spider {
  position: absolute;
  top: 0;
  left: 78px;
}

.spider-thread {
  width: 1px;
  height: 46px;
  margin: 0 auto;
  background: rgba(185, 160, 224, 0.4);
}

.spider-body {
  position: relative;
  width: 10px;
  height: 12px;
  margin: 0 auto;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 28%, #4a4a58 0%, #16161c 65%, #0a0a0d 100%);
  border: 1px solid rgba(185, 160, 224, 0.8);
  box-shadow: 0 0 6px rgba(0, 0, 0, 0.55);
  animation: spider-sway 3.4s ease-in-out infinite;
}

.spider-leg {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 11px;
  height: 8px;
  border-top: 1px solid rgba(185, 160, 224, 0.8);
  border-radius: 50% 0 0 0;
  transform-origin: 0 0;
}

.spider-leg--l1 { transform: rotate(-55deg); }
.spider-leg--l2 { transform: rotate(-30deg); }
.spider-leg--l3 { transform: rotate(-5deg) scaleY(-1); }
.spider-leg--l4 { transform: rotate(20deg) scaleY(-1); }
.spider-leg--r1 { transform: rotate(235deg) scaleX(-1); }
.spider-leg--r2 { transform: rotate(210deg) scaleX(-1); }
.spider-leg--r3 { transform: rotate(185deg) scaleX(-1) scaleY(-1); }
.spider-leg--r4 { transform: rotate(160deg) scaleX(-1) scaleY(-1); }

@keyframes spider-sway {
  0%, 100% { transform: translateX(0) rotate(0deg); }
  50%      { transform: translateX(2px) rotate(3deg); }
}

/* the "it noticed the fly" state — legs twitch faster, glow intensifies */
.spider-alert .spider-body {
  animation: spider-sway 0.4s ease-in-out infinite;
  box-shadow: 0 0 10px rgba(0, 0, 0, 0.85);
}

@media (max-width: 640px) {
  .corner-web {
    width: 110px;
    height: 110px;
  }
  .corner-web svg {
    width: 110px;
    height: 110px;
  }
  .spider {
    left: 48px;
  }
  .spider-thread {
    height: 28px;
  }
}
