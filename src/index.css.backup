@import url("https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap");

:root {
  font-family: "Geist", sans-serif;

  font-optical-sizing: auto;
  font-style: normal;
  line-height: 1.5;
  scroll-behavior: smooth;
  color-scheme: light dark;

  /* --- old house / horror palette --- */
  /* sickly graveyard green — the site-wide accent, same tone the skeletal
     cursor glows with. single source of truth for every purple this replaced. */
  --accentColor: #6f8f63;
  --accentColorDim: #4d6144;

  /* deep attic dark, warm rather than pure black */
  --backgroundColor: #0f0b0d;

  /* aged wood + candlelight, the warm counterpoint to the cold green */
  --woodColor: #3a2a22;
  --candleColor: #d9a15c;
  --dustColor: #cabfae;

  /* dried blood / rust — reserved for rare emphasis, not decoration */
  --rustColor: #5c2a24;

  color: #eae5ec;
  background-color: var(--backgroundColor);

  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  user-select: none;
  -webkit-user-select: none;
  -moz-user-select: none;
  --vh: 100vh;
  --vh: 100svh;
}

h1,
h2,
h3,
h4,
h5,
h6 {
  font-family: "Geist", sans-serif;
}

body {
  overflow: hidden;
}

/* Allow scrolling on mobile */
@media only screen and (max-width: 768px) {
  body {
    overflow: auto !important;
    height: auto !important;
    min-height: 100vh !important;
    touch-action: manipulation;
  }

  html {
    overflow-x: hidden !important;
    overflow-y: auto !important;
    touch-action: manipulation;
  }

  /* Ensure no fixed elements block scrolling */
  .container-main {
    position: static !important;
    height: auto !important;
  }
}

a {
  color: inherit;
  text-decoration: inherit;
}

a:hover {
  color: var(--accentColor);
}

main {
  opacity: 1;
  transition: 0.3s;
}

.main-active {
  opacity: 0;
  animation: fadeIn 1s 1;
  animation-fill-mode: forwards;
}

@keyframes fadeIn {
  100% {
    opacity: 1;
  }
}

body {
  margin: 0;
  height: auto;
  background-color: var(--backgroundColor);
  flex-grow: 1;
  --cWidth: calc(100% - 30px);
  --cMaxWidth: 1920px;
  max-width: 100vw;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
  position: relative;
}

/* faint aged-paper grain + vignette, like light through a dusty attic window */
body::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 0;
  background:
    radial-gradient(ellipse at 50% 0%, rgba(217, 161, 92, 0.06) 0%, transparent 55%),
    radial-gradient(ellipse at 50% 100%, rgba(0, 0, 0, 0.55) 0%, transparent 60%),
    radial-gradient(circle, rgba(0, 0, 0, 0) 60%, rgba(0, 0, 0, 0.5) 100%);
}

.main-body {
  max-width: 100vw;
  overflow-x: hidden;
  -webkit-overflow-scrolling: touch;
  position: relative;
  z-index: 1;
}

.container-main {
  width: 100%;
  margin: auto;
  position: relative;
}

.container1 {
  width: var(--cWidth);
  height: var(--vh);
  margin: auto;
  position: relative;
}

.split-line {
  overflow: hidden;
}

.split-h2 {
  overflow: hidden;
  display: flex;
  white-space: nowrap;
  flex-wrap: nowrap;
}

.techstack {
  width: 100%;
  position: relative;
  height: var(--vh);
  min-height: 100vh;
  margin: 0 auto;
  margin-top: 0;
  margin-bottom: 0;
  padding-top: 150px;
  padding-bottom: 150px;
  background: linear-gradient(180deg, rgba(15, 11, 13, 0.95) 0%, rgba(15, 11, 13, 0.98) 100%);
  background-color: var(--backgroundColor);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.techstack::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    radial-gradient(circle at 20% 50%, rgba(111, 143, 99, 0.09) 0%, transparent 50%),
    radial-gradient(circle at 80% 50%, rgba(217, 161, 92, 0.06) 0%, transparent 50%);
  pointer-events: none;
  z-index: 0;
}

.techstack>* {
  position: relative;
  z-index: 1;
}

.techstack h2 {
  font-size: 80px;
  text-align: center;
  position: absolute;
  width: 100%;
  top: 150px;
  left: 0;
  font-weight: 400;
  text-transform: uppercase;
  z-index: 3;
  margin: 0;
}

@media screen and (min-width: 768px) {
  body {
    --cWidth: 94%;
  }
}

@media screen and (max-width: 900px) {
  .techstack h2 {
    font-size: 40px;
  }
}